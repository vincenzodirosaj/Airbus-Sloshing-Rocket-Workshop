1                         CONERR - INPUT ERROR CHECKING
0 ERROR CODES - N* DENOTES THE NUMBER OF OCCURENCES OF EACH ERROR
0 A - UNKNOWN VARIABLE NAME
0 B - MISSING EQUAL SIGN FOLLOWING VARIABLE NAME
0 C - NON-ARRAY VARIABLE HAS AN ARRAY ELEMENT DESIGNATION - (N)
0 D - NON-ARRAY VARIABLE HAS MULTIPLE VALUES ASSIGNED
0 E - ASSIGNED VALUES EXCEED ARRAY DIMENSION
0 F - SYNTAX ERROR

0******************************  INPUT DATA CARDS  ******************************

 DIM M                                                                           
 DERIV RAD                                                                       
 DAMP                                                                            
 PART                                                                            
  $OPTINS BLREF=1.35, ROUGFC=0.25E-3$                                            
  $SYNTHS SCALE=1.0, VERTUP=.TRUE.,                                              
    XCG=0.68703, ZCG=-0.0075743,                                                 
    XW=0.65, ZW=0.015,  ALIW=0.0,                                                
    XH=1.2, ZH=-0.015$                                                           
  $BODY NX=2.0,                                                                  
        X(1)=0.0, 1.35,                                                          
        ZU(1)=0.015, 0.015,                                                      
        ZL(1)=-0.015, -0.015,                                                    
     R(1)=0.015, 0.015,                                                          
     P(1)=0.12, 0.12,                                                            
     S(1)=0.0009, 0.0009,                                                        
        ITYPE=1.0$                                                               
  $WGPLNF TYPE=1.0,                                                              
    CHRDR=0.45,   CHRDTP=0.45,                                                   
          SSPN=1.0,  SSPNE=0.985,                                                
          SAVSI=0.0,                                                             
          CHSTAT=0.25, TWISTA=0.0,                                               
          DHDADI=0.0$                                                            
 NACA W 4 6409                                                                   
  $HTPLNF TYPE=1.0,                                                              
    CHRDR=0.15, CHRDTP=0.15,                                                     
          SSPN=0.060777, SSPNE=0.33807,                                          
          SAVSI=0.0,                                                             
          CHSTAT=0.25, TWISTA=0.0,                                               
          DHDADI=-80.0$                                                          
 NACA H 4 0009                                                                   
  $FLTCON WT=5.0, LOOP=2.0,                                                      
          NMACH=1.0,                                                             
    MACH(1)=0.005,                                                               
          NALT=1.0,                                                              
    ALT(1)=0.0,                                                                  
          NALPHA=20.0,                                                           
          ALSCHD(1)= -16.0, -8.0, -6.0, -4.0, -2.0, 0.0, 2.0, 4.0, 8.0, 9.0,     
