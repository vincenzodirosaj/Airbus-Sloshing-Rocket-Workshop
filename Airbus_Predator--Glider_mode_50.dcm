*
*   Modello DATCOM dell'aliante per la competizione ASRW
*
*   Author : Piercarlo Mirto
*
*   Last update: Aprile 2023.
*
********************************************************************************
DIM M
DERIV RAD
DAMP
PART

********************************************************************************
*  Reference Parameters *   
********************************************************************************
 $OPTINS BLREF=1.35, ROUGFC=0.25E-3$



********************************************************************************
* Group II     Synthesis Parameters  
********************************************************************************
 $SYNTHS SCALE=1.0, VERTUP=.TRUE.,
		 XCG=0.68703, ZCG=-0.006719,
		 XW=0.65, ZW=0.015,  ALIW=0.0,
		 XH=1.2, ZH=-0.015$
		 
 
 
 
********************************************************************************
*  Body Configuration Parameters 
********************************************************************************
 $BODY NX=2.0,
       X(1)=0.0, 1.35,
       ZU(1)=0.015, 0.015,
       ZL(1)=-0.015, -0.015,
	   R(1)=0.015, 0.015,
	   P(1)=0.12, 0.12,
	   S(1)=0.0009, 0.0009,
       ITYPE=1.0$



********************************************************************************
*			Configurazione dell'ala
********************************************************************************
 $WGPLNF TYPE=1.0,
		 CHRDR=0.45,   CHRDTP=0.45,
         SSPN=1.0,  SSPNE=0.985,
         SAVSI=0.0,
         CHSTAT=0.25, TWISTA=0.0,
         DHDADI=0.0$


*  Sezione
NACA W 4 6409!0012



********************************************************************************
*			Configurazione del piano orizzontale
********************************************************************************
 $HTPLNF TYPE=1.0,
		 CHRDR=0.15, CHRDTP=0.15,
         SSPN=0.26812, SSPNE=0.33807,
         SAVSI=0.0,
         CHSTAT=0.25, TWISTA=0.0,
         DHDADI=-40.0$


* Profilo
NACA H 4 0009



********************************************************************************
*  Flight Conditions *
********************************************************************************
 $FLTCON WT=5.0, LOOP=2.0,
         NMACH=1.0,
		 MACH(1)=0.005,
         NALT=1.0,
		 ALT(1)=0.0,
         NALPHA=20.0,
         ALSCHD(1)= -16.0, -8.0, -6.0, -4.0, -2.0, 0.0, 2.0, 4.0, 8.0, 9.0,
             10.0, 12.0, 14.0, 16.0, 18.0, 19.0, 20.0, 21.0, 22.0, 24.0,
         STMACH=0.6, TSMACH=1.4, TR=1.0$



CASEID Airbus Glider